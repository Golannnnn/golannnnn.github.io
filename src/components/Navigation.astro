---
import ThemeToggle from "./ThemeToggle.astro";

const { pathname } = Astro.url;
const match = pathname.match(/^\/(\w+)?/);
---

<nav>
  <menu>
    <svg
      width="30"
      height="30"
      viewBox="0 0 24 24"
      class="hamburger"
      aria-hidden="true"
    >
      <path
        d="M4 6h16M4 12h16M4 18h16"
        stroke="var(--text-color)"
        stroke-width="2"></path>
      <path
        fill="var(--text-color)"
        d="m19 18-6-6 6-6-1.5-1.5-6 6-6-6-1.5 1.5 6 6-6 6 1.5 1.5 6-6 6 6z"
      ></path>
    </svg>
    <p class="menu__p">Menu</p>
  </menu>
  <ul class={match?.[1] === "board" ? "board" : ""}>
    <li><a href=`/` class={!match?.[1] ? "active" : ""}>Home</a></li>
    <li>
      <a href=`/blog` class={match?.[1] === "blog" ? "active" : ""}>Blog</a>
    </li>
    <li>
      <a href=`/board` class={match?.[1] === "board" ? "active" : ""}>Board</a>
    </li>
    <li>
      <a href=`/guestbook` class={match?.[1] === "guestbook" ? "active" : ""}
        >Guestbook</a
      >
    </li>
    <li>
      <ThemeToggle />
    </li>
  </ul>
</nav>

<style>
  nav {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    width: 100%;
  }

  menu {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    cursor: pointer;
    font-weight: 500;
    padding: 5px 9px 5px 5px;
    margin-top: -41px;
  }

  .show menu {
    border: 0.5px solid var(--border-color);
    border-bottom: none;
    background-color: var(--bg-color);
    z-index: 10;
  }

  .menu__p {
    font-size: 1.3rem;
  }

  path:last-child {
    display: none;
  }

  .show path:first-child {
    display: none;
  }

  .show path:last-child {
    display: block;
  }

  .show ul {
    display: flex;
  }

  ul {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 25px;
    list-style: none;
    width: 100%;

    padding: 25px;
    border: 0.5px solid var(--border-color);
    border-top: none;
    z-index: 1;
  }

  .board {
    background-color: var(--bg-color);
    z-index: 999999;
  }

  a {
    color: var(--text-color);
    text-decoration: none;
    font-size: 1.5rem;
  }

  a:hover {
    text-underline-offset: 5px;
    text-decoration: underline;
  }

  .active {
    font-weight: 600;
    text-underline-offset: 5px;
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    menu {
      display: none !important;
    }

    nav {
      margin-bottom: 10px;
    }

    ul {
      justify-content: flex-end;
      display: flex;
      flex-direction: row;
      align-items: center;
      margin-top: -45px;
      padding: 0;
      border: none;
      background-color: transparent;
    }

    .board {
      background-color: unset;
      z-index: 1;
    }

    a {
      font-size: 1.3rem;
    }
  }
</style>

<script>
  const nav: HTMLElement = document.querySelector("nav")!;
  const menu: HTMLElement = document.querySelector("menu")!;
  const menuP: HTMLElement = document.querySelector(".menu__p")!;
  const footer: HTMLElement = document.querySelector("footer")!;

  menu.addEventListener("click", (e: Event) => {
    const target = e.target as any;

    if (target === menu || menu.contains(target)) {
      nav.classList.toggle("show");
      const isShow = nav.classList.contains("show");
      menuP.textContent = isShow ? "Close" : "Menu";
      footer.style.display = isShow ? "none" : "block";
    }
  });

  document.addEventListener("click", (e: Event) => {
    const target = e.target as any;
    if (
      target !== menu &&
      !menu.contains(target) &&
      nav.classList.contains("show")
    ) {
      nav.classList.remove("show");
      menuP.textContent = "Menu";
      footer.style.display = "block";
    }
  });
</script>
