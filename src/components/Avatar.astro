<style>
  @media (min-width: 768px) {
    .avatar {
      width: 125px;
      height: auto;
      margin-top: -15px;
    }
  }
</style>

<script>
  const html: HTMLElement = document.documentElement;
  const avatar: HTMLElement = document.querySelector(".avatar")!;
  const avatarLeftEye: HTMLElement = document.querySelector(
    "#svga-group-eyesiriscontrol-left"
  )!;
  const avatarRightEye: HTMLElement = document.querySelector(
    "#svga-group-eyesiriscontrol-right"
  )!;

  let avatarCenterX: number;
  let avatarCenterY: number;
  let resizeTimer: number | undefined;

  function updateAvatarCenter(): void {
    const avatarRect: DOMRect = avatar.getBoundingClientRect();
    const avatarEyeRect: DOMRect = avatarLeftEye.getBoundingClientRect();
    avatarCenterX = avatarRect.left + avatarRect.width / 2;
    avatarCenterY = avatarEyeRect.top + avatarEyeRect.height / 2;
  }

  updateAvatarCenter();

  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(updateAvatarCenter, 250);
  });

  let animationFrameId: number;

  html.addEventListener("mousemove", (e: MouseEvent) => {
    cancelAnimationFrame(animationFrameId);
    animationFrameId = requestAnimationFrame(() => followMouse(e));
  });

  let previousTranslationX: number | null = null;
  let previousTranslationY: number | null = null;

  function followMouse(e: MouseEvent): void {
    const x: number = e.clientX - avatarCenterX;
    const y: number = e.clientY - avatarCenterY;

    const translationX: number = Math.max(-3, Math.min(3, x / 10));
    const translationY: number = Math.max(-3, Math.min(3, y / 10));

    if (
      previousTranslationX === translationX &&
      previousTranslationY === translationY
    ) {
      return;
    }

    avatarLeftEye.setAttribute(
      "transform",
      `translate(${translationX},${translationY})`
    );
    avatarRightEye.setAttribute(
      "transform",
      `translate(${translationX},${translationY})`
    );

    previousTranslationX = translationX;
    previousTranslationY = translationY;
  }
</script>
