---
import "../styles/global.css";
import Meta from "../components/Meta.astro";
import Header from "../components/Header.astro";

const { text, intro } = Astro.props;
---

<html lang="en">
  <head>
    <Meta title="Golan's portfolio" description="Golan's portfolio website" />
    <script is:inline>
      const element = document.documentElement;

      const storedTheme =
        typeof localStorage !== "undefined" && localStorage.getItem("theme");

      const colorScheme = window.matchMedia("(prefers-color-scheme: dark)")
        ? "dark"
        : "light";

      const theme = storedTheme || colorScheme;

      if (theme === "light") {
        element.classList.remove("dark");
      } else {
        element.classList.add("dark");
      }

      window.localStorage.setItem("theme", theme);
    </script>
  </head>
  <body>
    <a href="#main" class="skip-content">Skip to main content.</a>
    <Header text={text} intro={intro} />
    <main id="main">
      <slot />
    </main>

    <style>
      .skip-content {
        color: var(--bg-color);
        background-color: var(--link-color);
        right: 25%;
        padding: 10px 15px;
        position: absolute;
        transform: translateY(-100%);
        transition: transform 0.3s;
      }

      .skip-content:focus {
        transform: translateY(0%);
      }

      #main {
        padding: 10px 15px 15px 15px;
      }

      @media (min-width: 768px) {
        .skip-content {
          right: 40%;
        }

        #main {
          padding-top: 5px;
        }
      }
    </style>
  </body>
</html>
