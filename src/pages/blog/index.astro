---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base text="Blog" intro="Explore my">
  <ul>
    {
      posts.map((post) => (
        <li>
          <a
            href={`/blog/${post.id}/`}
            aria-label={`Read more about ${post.data.title}.`}
          />
          <p aria-hidden="true">{post.data.title}</p>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("en-UK", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
          <span aria-hidden="true" class="arrow-right">
            ⤷
          </span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 30px;
  }

  li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px 15px;
    border: 0.5px solid var(--border-color);
  }

  a {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  p {
    margin: 0;
    padding: 0;
    color: var(--link-color);
    font-size: 1.2rem;
    text-underline-offset: 2px;
  }

  li:hover p,
  li:focus-within p {
    text-decoration: underline;
    text-decoration-style: dashed;
  }

  /* li:hover span,
  li:focus-within span {
    opacity: 0.5;
  } */

  /* li:hover {
    box-shadow: 0 0 10px var(--shadow-color);
  } */

  time {
    font-size: 1rem;
    margin: 0;
  }

  .arrow-right {
    position: absolute;
    right: 15px;
    bottom: 25%;
    font-size: 1.5rem;
  }
</style>
